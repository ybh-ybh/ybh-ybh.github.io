---
import { Image } from "astro:assets";
import profileImage from "../assets/profile.png";
import { resumeData, resumeHero } from "../data/resume";

// 能力侧使用视频中的柔和彩色信号，节点、连线与光点共享同一个色调。
const skillTones = ["rose", "amber", "sky", "coral", "violet", "pink"] as const;
// 连线按能力与项目顺序生成，项目侧统一汇成青绿色。
const connections = [
  ...resumeHero.skills.map((_, index) => skillTones[index % skillTones.length]),
  ...resumeHero.projects.map(() => "mint"),
];
---

<section class="resume-hero" data-resume-hero aria-labelledby="resume-title">
  <div class="resume-flow" data-flow-canvas>
    <svg class="flow-connections" data-flow-svg aria-hidden="true" focusable="false">
      {connections.map((tone) => <path class="flow-line" data-flow-line data-flow-tone={tone} pathLength="1" />)}
      {connections.map((tone) => (
        <g class="flow-particle" data-flow-particle data-flow-tone={tone} opacity="0">
          <circle r="8" fill="currentColor" opacity="0.12" />
          <circle r="3" fill="currentColor" />
          <circle r="1" fill="var(--resume-grid-base)" />
        </g>
      ))}
    </svg>

    <div class="flow-group flow-skills">
      <h2 class="flow-caption">专业能力</h2>
      <ul class="flow-node-list">
        {resumeHero.skills.map((skill, index) => (
          <li class="flow-node" data-flow-node="skill" data-flow-tone={skillTones[index % skillTones.length]}>
            <span class="flow-node-dot" aria-hidden="true"></span>
            <span>{skill}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="flow-identity" data-flow-identity>
      <div class="flow-avatar-wrap" data-flow-hub>
        <div class="flow-halo" data-flow-halo aria-hidden="true"></div>
        <Image src={profileImage} alt={`${resumeData.profile.name}的头像`} width={224} height={224} format="webp" quality={90} loading="eager" fetchpriority="high" class="flow-avatar" />
      </div>
      <h1 id="resume-title" class="flow-name">{resumeData.profile.name}</h1>
      <p class="flow-role">{resumeData.profile.title}</p>
    </div>

    <div class="flow-group flow-projects">
      <h2 class="flow-caption">项目成果</h2>
      <ul class="flow-node-list">
        {resumeHero.projects.map((project) => (
          <li class="flow-node" data-flow-node="project" data-flow-tone="mint" title={resumeData.projects[project.projectIndex].project}>
            <svg class="flow-project-icon" aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3.5" width="14" height="13" rx="2.5" />
              <path d="M3 7.5h14M6 5.5h.1M8 5.5h.1M6.5 11h3M6.5 13.5h7" />
            </svg>
            <span>{project.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <a class="flow-scroll" href="#resume-profile">
    <span>向下浏览</span>
    <svg width="16" height="20" viewBox="0 0 16 20" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
      <path d="M8 2v14m-5-5 5 5 5-5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </a>
</section>

<style>
  .resume-hero {
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - var(--resume-shell-top));
    padding-block: 2rem 1.75rem;
  }

  /* 色调只用于节点装饰和线路，正文沿用主题文字色以保证对比度。 */
  [data-flow-tone="rose"] { --flow-tone: #d98091; }
  [data-flow-tone="amber"] { --flow-tone: #c99b3e; }
  [data-flow-tone="sky"] { --flow-tone: #749ed0; }
  [data-flow-tone="coral"] { --flow-tone: #d88e66; }
  [data-flow-tone="violet"] { --flow-tone: #a58acb; }
  [data-flow-tone="pink"] { --flow-tone: #c586ad; }
  [data-flow-tone="mint"] { --flow-tone: #43a58b; }

  [data-flow-tone] {
    /* 流动光点保留原色，避免低饱和线条让动态信号难以分辨。 */
    --flow-signal: var(--flow-tone);
    /* 淡色细线连接同色节点，不遮挡网格与中央身份信息。 */
    --flow-line: color-mix(in srgb, var(--flow-tone) 52%, var(--resume-grid-base));
    /* 标签边框与路径保持相近饱和度。 */
    --flow-node-border: color-mix(in srgb, var(--flow-tone) 40%, var(--resume-grid-base));
    /* 很浅的同色底衬让节点与对应路径关联。 */
    --flow-node-bg: color-mix(in srgb, var(--flow-tone) 6%, var(--resume-grid-base));
  }

  :global(html[data-theme="dark"]) [data-flow-tone] {
    /* 深色背景下略提亮光点，色相不随主题改变。 */
    --flow-signal: color-mix(in srgb, var(--flow-tone) 76%, #fff);
    /* 深色线条压低亮度，避免形成刺眼的霓虹效果。 */
    --flow-line: color-mix(in srgb, var(--flow-tone) 48%, var(--resume-grid-base));
    /* 提高底衬的色彩比例，保持深色节点可辨。 */
    --flow-node-bg: color-mix(in srgb, var(--flow-tone) 10%, var(--resume-grid-base));
  }

  .resume-flow {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(12rem, 0.95fr) minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    flex: 1;
    min-height: 29rem;
  }

  .flow-connections {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: -1;
  }

  .flow-line {
    fill: none;
    stroke: var(--flow-line);
    stroke-width: 1.15;
    vector-effect: non-scaling-stroke;
  }

  .flow-particle { color: var(--flow-signal); }

  .flow-group { min-width: 0; }

  .flow-caption {
    margin-bottom: 1.75rem;
    color: var(--muted-ink);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.18em;
  }

  .flow-node-list {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .flow-skills { padding-left: clamp(0rem, 4vw - 2rem, 2rem); }
  .flow-skills .flow-caption { padding-left: 1.1rem; }
  .flow-skills .flow-node:nth-child(1),
  .flow-skills .flow-node:nth-child(6) { margin-left: 1.5rem; }

  .flow-node {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    max-width: 100%;
    min-height: 2.6rem;
    padding: 0.65rem 1rem;
    border: 1px solid var(--flow-node-border);
    border-radius: 999px;
    background: var(--flow-node-bg);
    color: var(--body-copy);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .flow-node-dot {
    flex-shrink: 0;
    width: 0.4rem;
    height: 0.4rem;
    border: 1px solid var(--flow-signal);
    border-radius: 50%;
  }

  .flow-identity {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 6rem;
    text-align: center;
  }

  .flow-avatar-wrap {
    position: relative;
    width: 7rem;
    height: 7rem;
  }

  .flow-halo {
    position: absolute;
    z-index: -1;
    inset: -7rem;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 64% 32%, rgb(83 202 151 / 36%), transparent 55%),
      radial-gradient(ellipse at 40% 72%, rgb(234 204 91 / 33%), transparent 53%),
      radial-gradient(ellipse at 24% 42%, rgb(231 147 173 / 20%), transparent 48%),
      radial-gradient(ellipse at 78% 68%, rgb(112 176 224 / 16%), transparent 48%);
    filter: blur(12px);
  }

  :global(html[data-theme="dark"]) .flow-halo {
    background:
      radial-gradient(ellipse at 64% 32%, rgb(70 193 140 / 30%), transparent 55%),
      radial-gradient(ellipse at 40% 72%, rgb(215 187 75 / 22%), transparent 53%),
      radial-gradient(ellipse at 24% 42%, rgb(218 123 160 / 20%), transparent 48%),
      radial-gradient(ellipse at 78% 68%, rgb(100 160 218 / 17%), transparent 48%);
  }

  .flow-avatar {
    display: block;
    width: 100%;
    height: 100%;
    border: 1px solid rgb(110 176 155 / 40%);
    border-radius: 1.75rem;
    object-fit: cover;
    box-shadow: 0 0 0 6px rgb(117 183 147 / 7%);
  }

  .flow-name {
    margin-top: 1.6rem;
    color: var(--page-ink);
    font-size: clamp(2rem, 3.2vw, 3rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.04em;
  }

  .flow-role {
    margin-top: 0.8rem;
    color: var(--body-copy);
    font-size: clamp(0.75rem, 1vw, 0.875rem);
    line-height: 1.8;
  }

  .flow-projects { justify-self: end; }
  .flow-projects .flow-caption { padding-left: 1rem; }
  .flow-projects .flow-node-list { gap: 2.5rem; }
  .flow-projects .flow-node:nth-child(2),
  .flow-projects .flow-node:nth-child(3) { margin-left: 1.5rem; }
  .flow-project-icon { width: 1.05rem; height: 1.05rem; flex-shrink: 0; color: var(--flow-signal); }

  .flow-scroll {
    align-self: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    margin-top: 2rem;
    padding: 0.5rem 1rem;
    color: var(--muted-ink);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .flow-scroll:hover { color: var(--accent-ink); }
  .flow-scroll:focus-visible { outline: 2px solid var(--accent-ink); outline-offset: 5px; border-radius: 4px; }

  /* 左右节点数量不同，以同高区域对齐标题和首尾节点。 */
  @media (min-width: 768px) {
    .flow-group { display: flex; flex-direction: column; height: 26rem; }
    .flow-node-list { flex: 1; justify-content: space-between; }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .flow-node { font-size: 0.75rem; padding-inline: 0.75rem; gap: 0.45rem; }
    .flow-skills .flow-node:nth-child(n),
    .flow-projects .flow-node:nth-child(n) { margin-left: 0; }
    .flow-avatar-wrap { width: 5.5rem; height: 5.5rem; }
    .flow-project-icon { width: 0.9rem; height: 0.9rem; }
  }

  /* 窄屏让两列标签之间留出布线通道，文字保持正常大小。 */
  @media (max-width: 767px) {
    .resume-hero { padding-block: 0.5rem 0.75rem; }
    .resume-flow { display: flex; flex-direction: column; gap: 3.5rem; min-height: auto; }
    .flow-group { width: 100%; }
    .flow-caption { position: relative; width: max-content; margin: 0 auto 1rem; padding-inline: 0.5rem; background: var(--resume-grid-base); text-align: center; font-size: 0.6875rem; }
    .flow-skills { padding-left: 0; }
    .flow-skills .flow-caption,
    .flow-projects .flow-caption { padding-left: 0; }
    .flow-node-list,
    .flow-projects .flow-node-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.65rem 1.5rem; }
    .flow-skills .flow-node:nth-child(n),
    .flow-projects .flow-node:nth-child(n) { margin-left: 0; }
    .flow-node { justify-content: center; min-height: 2.4rem; padding: 0.55rem 0.45rem; gap: 0.4rem; font-size: 0.75rem; }
    .flow-node-dot { width: 0.3rem; height: 0.3rem; }
    .flow-identity { padding-top: 0; }
    .flow-avatar-wrap { width: 5rem; height: 5rem; }
    .flow-avatar { border-radius: 1.25rem; }
    .flow-halo { inset: -5rem; }
    .flow-name { margin-top: 1rem; font-size: 2rem; }
    .flow-role { margin-top: 0.5rem; font-size: 0.75rem; }
    .flow-projects .flow-node { min-height: 3.4rem; border-radius: 1rem; text-align: center; }
    .flow-project-icon { display: none; }
    .flow-scroll { margin-top: 1.75rem; }
  }

  @media (max-width: 359px) {
    .flow-node { font-size: 0.6875rem; }
    .flow-node-dot { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow-scroll { transition: none; }
    .flow-particle { display: none; }
  }
</style>

<script>
  import { initResumeHero } from "../scripts/resumeHero";

  // 热更新只释放首屏自己的动画与观察器。
  const disposeResumeHero = initResumeHero();
  if (import.meta.hot) import.meta.hot.dispose(disposeResumeHero);
</script>

---
import { siteConfig } from "../config";
import BookShelf from "./BookShelf.astro";
import LocalizedText from "./LocalizedText.astro";
import { copy } from "../i18n";
// 沿用其他区域的蓝色标题装饰。
const accent = siteConfig.accentColor;
---

<section id="books" class="section-shell" aria-labelledby="books-title">
  <div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
      <div class="lg:col-span-4">
        <h2 id="books-title" class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900 dark:text-slate-100">
          <LocalizedText text={copy.headings.books} />
        </h2>
        <div class="w-[75px] h-[5px] mt-2 rounded-full" style={`background-color: ${accent}`} />
      </div>

      <figure class="lg:col-span-8 text-lg sm:text-xl md:text-2xl leading-relaxed text-gray-600 dark:text-slate-300">
        <blockquote>
          <p><LocalizedText text={copy.books.intro} /></p>
        </blockquote>
        <figcaption class="mt-6 text-right">—— <LocalizedText text={copy.books.author} /></figcaption>
      </figure>
    </div>

    <div class="mt-10 lg:mt-16">
      <BookShelf items={siteConfig.books.items} />
    </div>
  </div>
</section>

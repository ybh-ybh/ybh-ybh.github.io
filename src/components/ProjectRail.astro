---
import { siteConfig } from "../config";
import LocalizedText from "./LocalizedText.astro";
import { copy, localizedAttrs, type LocalizedText as Translation } from "../i18n";

interface Props {
  items: { id: string; title: Translation; summary: Translation; jumpLabel: Translation }[];
}

// 导航直接消费项目列表，不额外维护一套名称和顺序。
const { items } = Astro.props;
---

<nav class="project-rail" data-project-rail data-visible="false" {...localizedAttrs("aria-label", copy.project.navigation)} aria-hidden="true" inert style={{ "--project-accent": siteConfig.accentColor }}>
  <ol class="project-rail-list" data-project-rail-list>
    {items.map((item) => (
      <li>
        <a class="project-rail-link" href={`#${item.id}`} draggable="false" data-project-link data-preview-id={`preview-${item.id}`} {...localizedAttrs("aria-label", item.jumpLabel)}>
          <span class="project-rail-tick" aria-hidden="true"></span>
        </a>
      </li>
    ))}
  </ol>
  <p class="project-rail-count" data-project-current aria-hidden="true">01</p>
  {items.map((item) => (
    <div id={`preview-${item.id}`} class="project-rail-preview" data-project-preview data-open="false" role="tooltip" aria-hidden="true">
      <p class="project-rail-title"><LocalizedText text={item.title} /></p>
      <p class="project-rail-summary"><LocalizedText text={item.summary} /></p>
    </div>
  ))}
</nav>

<style>
  .project-rail {
    display: none;
    position: fixed;
    z-index: 40;
    top: 50%;
    right: 20px;
    width: 48px;
    padding: 16px 5px;
    border: 1px solid var(--border-color);
    border-radius: 24px;
    background: var(--rail-glass);
    box-shadow: 0 6px 24px -8px rgb(15 23 42 / 18%);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    transform: translateY(-50%);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 160ms ease, visibility 160ms ease;
  }

  @media (min-width: 1024px) and (hover: hover) and (pointer: fine) {
    .project-rail { display: block; }
    .project-rail[data-visible="true"] {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }
  }

  .project-rail-list { margin: 0 0 8px; padding: 0; list-style: none; user-select: none; }
  .project-rail-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 48px;
    padding: 4px;
    border-radius: 6px;
  }
  .project-rail-link:focus-visible { outline: 2px solid var(--accent-ink); outline-offset: 2px; }
  .project-rail-tick {
    display: block;
    flex-shrink: 0;
    width: var(--tick-width, 18px);
    height: 3px;
    border-radius: 999px;
    background: #94a3b8;
    transition: width 120ms ease-out, background-color 120ms ease;
  }
  .project-rail-link[data-previewing="true"] .project-rail-tick { background: var(--page-ink); }
  .project-rail-link[aria-current="location"] .project-rail-tick { background: var(--accent-ink); }
  .project-rail-count { color: var(--accent-ink); font-size: 10px; font-weight: 600; font-variant-numeric: tabular-nums; line-height: 16px; text-align: center; }
  .project-rail-preview {
    position: absolute;
    right: calc(100% + 12px);
    top: 50%;
    width: 280px;
    padding: 18px 20px;
    border: 1px solid var(--border-color);
    border-radius: 16px;
    background: var(--preview-glass);
    box-shadow: 0 16px 40px -16px rgb(17 24 39 / 24%);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate(8px, -50%);
    transition: opacity 150ms ease, transform 150ms ease, visibility 150ms ease;
  }
  .project-rail-preview[data-open="true"] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(0, -50%);
  }
  /* 透明桥接区允许指针越过间隙进入预览，避免途中被收起。 */
  .project-rail-preview::after { content: ""; position: absolute; left: 100%; top: 0; bottom: 0; width: 16px; }
  .project-rail-title { color: var(--page-ink); font-size: 14px; font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; }
  .project-rail-summary {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    margin-top: 8px;
    color: var(--muted-ink);
    font-size: 12px;
    line-height: 1.8;
  }
  @media (prefers-reduced-motion: reduce) {
    .project-rail, .project-rail-tick, .project-rail-preview { transition: none; }
  }
  @media (prefers-reduced-transparency: reduce) {
    .project-rail { background: var(--surface); -webkit-backdrop-filter: none; backdrop-filter: none; }
  }
</style>

<script>
  import { initProjectRail } from "../scripts/projectRail";

  // 热更新时只销毁项目导航自己的监听和状态。
  const disposeProjectRail = initProjectRail();
  if (import.meta.hot) import.meta.hot.dispose(disposeProjectRail);
</script>

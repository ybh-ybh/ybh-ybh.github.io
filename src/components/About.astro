---
import { siteConfig } from "../config";
---

<section id="about" data-scatter-section class="section-shell">
  <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-16">
    <div data-scatter-item data-scatter-side="left" class="lg:col-span-4">
      <div data-scatter-motion>
        <h2 class="section-title">关于我</h2>
        <div class="section-rule" style={{ backgroundColor: siteConfig.accentColor }}></div>
      </div>
    </div>

    <div class="space-y-8 lg:col-span-8">
      <div data-scatter-group class="space-y-5">
        {siteConfig.about.map((paragraph, index) => (
          <div data-scatter-item data-scatter-side="right">
            <div data-scatter-motion>
              <p class:list={["leading-relaxed text-gray-600 dark:text-slate-300", index === 0 ? "text-lg sm:text-xl md:text-2xl" : "text-base sm:text-lg"]}>
                {paragraph}
              </p>
            </div>
          </div>
        ))}
      </div>

      <div class="grid gap-3 pt-2 sm:grid-cols-2">
        {/* 按卡片原有列顺序指定拨开方向。 */}
        {siteConfig.capabilityGroups.map((group, index) => (
          <div data-scatter-item data-scatter-side={index % 2 === 0 ? "left" : "right"} class="min-w-0">
            <div data-scatter-motion class="h-full rounded-2xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-5">
              <h3 class="text-sm font-bold text-gray-900 dark:text-slate-100">{group.name}</h3>
              <div class="mt-3 flex flex-wrap gap-2">
                {group.skills.map((skill) => (
                  <span class="inline-flex max-w-full items-center gap-1.5 whitespace-nowrap rounded-md bg-gray-100 dark:bg-slate-700 px-2.5 py-1 text-xs font-medium text-gray-700 dark:text-slate-300">
                    {/* 技术名称已提供语义，品牌图标仅作装饰并保持原始比例。 */}
                    <img src={skill.icon} alt="" aria-hidden="true" width="18" height="18" class="size-[18px] shrink-0 object-contain dark:rounded-sm dark:bg-slate-100 dark:p-px" />
                    <span>{skill.name}</span>
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

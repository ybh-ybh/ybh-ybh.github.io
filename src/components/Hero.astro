---
import { siteConfig } from "../config";
import { Image } from "astro:assets";
import profileImage from "../assets/profile.png";
---

<section
  id="hero"
  data-scatter-section
  class="relative isolate min-h-[740px] bg-white py-24 md:h-screen"
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <div
    class="absolute inset-0 -z-10"
    style={`background: radial-gradient(ellipse 800px 1200px at 0% 0%, ${siteConfig.accentColor}40 0%, ${siteConfig.accentColor}25 20%, ${siteConfig.accentColor}10 40%, rgba(255, 255, 255, 0.3) 70%, rgba(255, 255, 255, 0.8) 90%, white 100%)`}
  ></div>
  <svg
    aria-hidden="true"
    class="absolute inset-0 -z-10 size-full stroke-gray-200 [mask-image:radial-gradient(100%_100%_at_top_right,white,transparent)]"
  >
    <defs>
      <pattern x="50%" y={-1} id="hero-grid" width={200} height={200} patternUnits="userSpaceOnUse">
        <path d="M.5 200V.5H200" fill="none"></path>
      </pattern>
      <pattern id="programming-symbols" x="0" y="0" width="400" height="400" patternUnits="userSpaceOnUse">
        <text x="50" y="50" fill={siteConfig.accentColor} font-family="monospace" font-size="24" transform="rotate(-15)">&lt;/&gt;</text>
        <text x="150" y="100" fill={siteConfig.accentColor} font-family="monospace" font-size="20" transform="rotate(10)">{}</text>
        <text x="250" y="80" fill={siteConfig.accentColor} font-family="monospace" font-size="18" transform="rotate(-5)">=&gt;</text>
        <text x="100" y="200" fill={siteConfig.accentColor} font-family="monospace" font-size="22" transform="rotate(15)">[]</text>
        <text x="300" y="180" fill={siteConfig.accentColor} font-family="monospace" font-size="20" transform="rotate(-10)">&lt;&gt;</text>
        <text x="200" y="250" fill={siteConfig.accentColor} font-family="monospace" font-size="24" transform="rotate(5)">()</text>
        <text x="50" y="320" fill={siteConfig.accentColor} font-family="monospace" font-size="18" transform="rotate(-8)">::</text>
        <text x="350" y="300" fill={siteConfig.accentColor} font-family="monospace" font-size="22" transform="rotate(12)">==</text>
        <text x="150" y="350" fill={siteConfig.accentColor} font-family="monospace" font-size="20" transform="rotate(-15)">++</text>
      </pattern>
    </defs>
    <rect fill="url(#programming-symbols)" width="100%" height="100%" opacity="0.2"></rect>
    <rect fill="url(#hero-grid)" width="100%" height="100%" stroke-width={0}></rect>
  </svg>

  <div class="mx-auto flex h-full max-w-7xl items-center p-8 sm:p-12 md:p-24">
    <div data-scatter-group data-scatter-start="center" class="hero-layout w-full">
      <div class="hero-identity max-w-5xl">
        <div data-scatter-item data-scatter-side="left">
          <div data-scatter-motion>
            <p class="animate-fade-in text-xl font-bold tracking-tight text-gray-700 sm:text-2xl md:text-5xl">你好 👋</p>
          </div>
        </div>
        <div data-scatter-item data-scatter-side="left" class="mt-4 sm:mt-6 md:mt-8 lg:mt-10">
          <div data-scatter-motion>
            <h1 class="animation-delay-200 animate-fade-in whitespace-nowrap text-[clamp(1.75rem,8vw,2rem)] font-bold leading-tight tracking-tight text-gray-800 sm:text-5xl md:text-6xl lg:text-8xl">
              我是 <span style={{ color: siteConfig.accentColor }}>{siteConfig.name}</span>
            </h1>
          </div>
        </div>
      </div>

      <div class="hero-copy max-w-5xl">
        <div data-scatter-item data-scatter-side="left" class="mt-5 md:mt-8">
          <div data-scatter-motion>
            <p class="animation-delay-400 animate-fade-in text-base font-semibold text-gray-700 sm:text-lg md:text-xl">
              {siteConfig.title}
            </p>
          </div>
        </div>
        <div data-scatter-item data-scatter-side="left" class="mt-3 max-w-3xl">
          <div data-scatter-motion>
            <p class="animation-delay-400 animate-fade-in text-base leading-relaxed text-gray-600 sm:text-lg md:text-xl">
              {siteConfig.heroStatement}
            </p>
          </div>
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <div data-scatter-item data-scatter-side="left">
            <div data-scatter-motion>
              <div class="animation-delay-600 animate-fade-in flex">
                <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-lg px-5 py-3 text-sm font-semibold text-white transition-all hover:-translate-y-0.5 hover:shadow-lg" style={{ backgroundColor: siteConfig.accentColor }}>
                  GitHub 主页 ↗
                </a>
              </div>
            </div>
          </div>
          <div data-scatter-item data-scatter-side="left">
            <div data-scatter-motion>
              <div class="animation-delay-600 animate-fade-in flex">
                <a href={siteConfig.social.blog} target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-lg border border-gray-300 bg-white/70 px-5 py-3 text-sm font-semibold text-gray-800 transition-all hover:-translate-y-0.5 hover:border-gray-500">
                  我的博客
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="animation-delay-600 animate-fade-in mt-8 flex gap-x-6 text-gray-700 md:gap-x-8">
          <!--<a href={`mailto:${siteConfig.social.email}`} aria-label="Email" class="transition-colors hover:text-[var(&#45;&#45;accent-color)]">-->
          <!--  <svg class="size-7 md:size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Z"/><path d="m3 7 9 6 9-6"/></svg>-->
          <!--</a>-->
          <!--<a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="transition-colors hover:text-[var(&#45;&#45;accent-color)]">-->
          <!--  <svg class="size-7 md:size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/></svg>-->
          <!--</a>-->
          <!--<a href={siteConfig.social.douyin} target="_blank" rel="noopener noreferrer" aria-label="抖音" class="transition-colors hover:text-[var(&#45;&#45;accent-color)]">-->
          <!--  <svg class="size-7 md:size-8" viewBox="0 0 448 512" fill="currentColor"><path d="M448 209.91a210.06 210.06 0 0 1-122.77-39.25v178.72A162.55 162.55 0 1 1 185 188.31v89.89a74.62 74.62 0 1 0 52.23 71.18V0h88a121.18 121.18 0 0 0 1.86 22.17A122.18 122.18 0 0 0 381 102.39a121.43 121.43 0 0 0 67 20.14z"/></svg>-->
          <!--</a>-->
        </div>
      </div>

      <div data-scatter-item data-scatter-side="right" class="hero-portrait">
        <div data-scatter-motion>
          <div class="animation-delay-600 animate-fade-in relative">
            <div
              aria-hidden="true"
              class="absolute -inset-1.5 rotate-2 rounded-[1.25rem] border lg:-inset-3 lg:rotate-3 lg:rounded-[2rem]"
              style={{ borderColor: `${siteConfig.accentColor}45` }}
            ></div>
            <div class="relative aspect-square overflow-hidden rounded-[1rem] border-2 border-white bg-gray-200 shadow-xl shadow-gray-900/20 lg:rounded-[1.75rem] lg:border-4 lg:shadow-2xl">
              <Image
                src={profileImage}
                alt={`${siteConfig.name}的职业头像`}
                width={680}
                height={680}
                format="webp"
                quality={86}
                class="size-full object-cover"
                loading="eager"
                fetchpriority="high"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

</section>

<style>
  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 5rem;
    grid-template-areas:
      "identity portrait"
      "copy copy";
    align-items: center;
    column-gap: 1rem;
    row-gap: 0.75rem;
  }

  .hero-identity {
    grid-area: identity;
    min-width: 0;
  }

  .hero-copy {
    grid-area: copy;
  }

  .hero-portrait {
    grid-area: portrait;
    justify-self: end;
    width: 5rem;
  }

  @media (min-width: 640px) {
    .hero-layout {
      grid-template-columns: minmax(0, 1fr) 6rem;
      column-gap: 1.5rem;
    }

    .hero-portrait {
      width: 6rem;
    }
  }

  @media (min-width: 1024px) {
    .hero-layout {
      grid-template-columns: minmax(0, 1fr) minmax(280px, 340px);
      grid-template-areas:
        "identity portrait"
        "copy portrait";
      column-gap: 4rem;
      row-gap: 0;
    }

    .hero-portrait {
      justify-self: stretch;
      width: 100%;
    }
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in { animation: fadeIn 0.8s ease-out forwards; opacity: 0; }
  .animation-delay-200 { animation-delay: 0.2s; }
  .animation-delay-400 { animation-delay: 0.4s; }
  .animation-delay-600 { animation-delay: 0.6s; }

  @media (prefers-reduced-motion: reduce) {
    .animate-fade-in {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<label class="switch border border-gray-300 dark:border-slate-600 bg-white/80 dark:bg-slate-800/80 transition-all hover:-translate-y-0.5 hover:border-gray-500" title="切换明暗主题">
  <input type="checkbox" role="switch" aria-label="浅色主题" data-theme-toggle checked />
  <span class="slider" aria-hidden="true">
    <span class="star star_1"></span>
    <span class="star star_2"></span>
    <span class="star star_3"></span>
    <svg viewBox="0 0 16 16" class="cloud_1 cloud">
      <path transform="matrix(.77976 0 0 .78395-299.99-418.63)" fill="#fff" d="m391.84 540.91c-.421-.329-.949-.524-1.523-.524-1.351 0-2.451 1.084-2.485 2.435-1.395.526-2.388 1.88-2.388 3.466 0 1.874 1.385 3.423 3.182 3.667v.034h12.73v-.006c1.775-.104 3.182-1.584 3.182-3.395 0-1.747-1.309-3.186-2.994-3.379.007-.106.011-.214.011-.322 0-2.707-2.271-4.901-5.072-4.901-2.073 0-3.856 1.202-4.643 2.925" />
    </svg>
  </span>
</label>

<style>
  /* 保留用户提供的日月、星星与云朵，按导航按钮高度缩小。 */
  .switch { font-size: 14px; position: relative; display: inline-block; flex-shrink: 0; width: calc(4em + 8px); height: calc(2.2em + 8px); border-radius: 30px; vertical-align: middle; }
  /* 原生控件覆盖 44px 点击高度，同时保留键盘焦点。 */
  .switch input { position: absolute; inset: -3px 0; z-index: 1; opacity: 0; width: 100%; height: calc(100% + 6px); margin: 0; cursor: pointer; }
  .slider { position: absolute; inset: 3px; background-color: #2a2a2a; transition: background-color 0.4s; border-radius: 30px; overflow: hidden; }
  .slider::before { position: absolute; content: ""; height: 1.2em; width: 1.2em; border-radius: 20px; left: 0.5em; bottom: 0.5em; transition: transform 0.4s cubic-bezier(0.81, -0.04, 0.38, 1.5), box-shadow 0.4s; box-shadow: inset 8px -4px 0 0 #fff; }
  .switch input:checked + .slider { background-color: #00a6ff; }
  .switch input:checked + .slider::before { transform: translateX(1.8em); box-shadow: inset 15px -4px 0 15px #ffcf48; }
  .switch input:focus-visible + .slider { outline: 2px solid var(--accent-ink); outline-offset: 4px; }
  .star { background-color: #fff; border-radius: 50%; position: absolute; width: 5px; height: 5px; transition: opacity 0.4s; }
  .star_1 { left: 2.5em; top: 0.5em; }
  .star_2 { left: 2.2em; top: 1.2em; }
  .star_3 { left: 3em; top: 0.9em; }
  .switch input:checked + .slider .star { opacity: 0; }
  .cloud { width: 3.5em; position: absolute; bottom: -1.4em; left: -1.1em; opacity: 0; transition: opacity 0.4s; }
  .switch input:checked + .slider .cloud { opacity: 1; }
  /* 脚本初始化前，开关直接反映头部预先恢复的深色状态。 */
  :global(html[data-theme="dark"]) .switch input:checked + .slider { background-color: #2a2a2a; }
  :global(html[data-theme="dark"]) .switch input:checked + .slider::before { transform: none; box-shadow: inset 8px -4px 0 0 #fff; }
  :global(html[data-theme="dark"]) .switch input:checked + .slider .star { opacity: 1; }
  :global(html[data-theme="dark"]) .switch input:checked + .slider .cloud { opacity: 0; }
</style>

<script>
  import { initTheme } from "../scripts/theme";

  // 桌面和手机使用同一个导航开关，保持主题初始化入口独立。
  const disposeTheme = initTheme();
  if (import.meta.hot) import.meta.hot.dispose(disposeTheme);
</script>

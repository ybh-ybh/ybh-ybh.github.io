---
import { siteConfig } from "../config";
// 恢复下方贡献模板时，同时启用图标导入和 config.ts 中的模板配置。
// import whisperIcon from "../icon/whisperkit-argmax-black@120.png";
// 当前展示的开源贡献内容。
const project = siteConfig.openSource;
// 沿用站点强调色。
const accent = siteConfig.accentColor;
---

<section id="opensource" class="section-shell">
  <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <h2 class="section-title">开源贡献</h2>
      <div class="section-rule" style={{ backgroundColor: accent }}></div>
    </div>

    {/* WhisperKit 贡献模板：复用时恢复此卡片，并移除下方占位卡片。
    <article class="min-w-0 lg:col-span-8" aria-labelledby="whisperkit-title">
      <div class="relative overflow-hidden rounded-2xl bg-gray-900 p-6 text-white sm:p-8">
        <div
          class="absolute -right-20 -top-24 size-64 rounded-full"
          style={`background: radial-gradient(circle, ${accent}66 0%, transparent 70%)`}
        ></div>
        <div class="relative z-10 flex flex-col gap-6 sm:flex-row sm:items-start">
          <img src={whisperIcon.src} alt="WhisperKit" class="h-12 w-auto shrink-0 rounded-lg bg-white p-1.5 object-contain" />
          <div>
            <h3 id="whisperkit-title" class="text-2xl font-bold sm:text-3xl">WhisperKit</h3>
            <p class="mt-3 text-sm leading-relaxed text-gray-300 sm:text-base">{project.frameworkIntro}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {project.impactFacts.map((fact) => (
                <span class="rounded-full border border-gray-700 bg-gray-800 px-3 py-1.5 text-xs font-semibold text-gray-200">{fact}</span>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- 左右缩进突出从属关系；顶部去掉圆角与边框，避免出现拼接缝。 -->
      <div class="mx-2 rounded-b-2xl border-x border-b border-gray-200 bg-white p-5 sm:mx-6 sm:p-8">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <h4 class="text-xl font-bold text-gray-900 sm:text-2xl">{project.name}</h4>
          <a href={project.prLink} target="_blank" rel="noopener noreferrer" class="shrink-0 rounded-full px-4 py-2 text-xs font-bold text-white" style={{ backgroundColor: accent }}>PR #511 · 已合入 ↗</a>
        </div>

        <p class="mt-4 text-sm leading-relaxed text-gray-600 sm:text-base">{project.description}</p>

        <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold">
          <a href={project.airTrimLink} target="_blank" rel="noopener noreferrer" class="text-blue-700 underline underline-offset-4">AirTrim 项目 ↗</a>
          <a href={project.repoLink} target="_blank" rel="noopener noreferrer" class="text-gray-700 underline underline-offset-4">WhisperKit 源码 ↗</a>
        </div>
      </div>
    </article>
    */}

    <article class="min-w-0 rounded-2xl border border-gray-200/60 bg-[#F7F8FA] p-6 text-gray-500 sm:p-8 lg:col-span-8">
      <h3 class="text-lg font-medium sm:text-xl">{project.description}</h3>
    </article>
  </div>
</section>

---
import LocalizedText from "./LocalizedText.astro";
import { bilingual, bookDetails, copy, localizedAttrs } from "../i18n";

interface Book {
  title: string;
  spineAuthor: string;
  spineArtwork?: string;
  spineEnglishTitle?: string;
  spinePublisher?: string[];
  spineInk?: string;
  spineMutedInk?: string;
  spineVariant?: "thinking" | "naval" | "history" | "mao";
  spineSubtitle?: string;
  authors: string;
  category: string;
  description: string;
}

interface Props {
  items: (Book | null)[];
}

// 十个位置参与同一组单选切换，未填内容的位置保持纯黑。
const { items } = Astro.props;
// 沿用原画廊 45% 的展开比例，剩余位置均分其他宽度。
const expandedGrow = items.length > 1 ? (0.45 * (items.length - 1)) / 0.55 : 1;
---

<div class="book-shelf" data-book-shelf data-active="0" role="group" {...localizedAttrs("aria-label", copy.books.label)} style={{ "--book-expanded-grow": expandedGrow }}>
  <div class="book-shelf-scroll">
    <div class="book-track">
      {items.map((book, index) => (
        <div class:list={["book", { "book-placeholder": !book }]} data-book>
          <input class="book-select sr-only" type="radio" name="recommended-books" id={`book-option-${index}`} checked={index === 0} {...localizedAttrs("aria-label", bilingual(book ? `${book.title}，${book.authors}` : `第 ${index + 1} 本书，待补充`, book ? `${bookDetails[index]!.title.en}, ${bookDetails[index]!.authors.en}` : `Book ${index + 1}, coming soon`))} aria-controls={`book-page-${index}`} />
          <label class:list={["book-spine", { "book-spine-illustrated": book?.spineArtwork }, book?.spineVariant && `book-spine-${book.spineVariant}`]} for={`book-option-${index}`} style={book?.spineArtwork ? { backgroundImage: `url(${book.spineArtwork})`, "--book-spine-ink": book.spineInk, "--book-spine-muted": book.spineMutedInk } : undefined}>
            {book && <>
              {book.spineEnglishTitle && <span class="book-spine-english" aria-hidden="true">{book.spineEnglishTitle}</span>}
              <span class="book-spine-title" aria-hidden="true">{book.title}</span>
              <span class="book-spine-author" aria-hidden="true">{book.spineAuthor}</span>
              {book.spineSubtitle && <span class="book-spine-subtitle" aria-hidden="true">{book.spineSubtitle}</span>}
              {book.spinePublisher && <span class="book-spine-publisher" aria-hidden="true">{book.spinePublisher.map((line) => <span>{line}</span>)}</span>}
            </>}
          </label>
          <div id={`book-page-${index}`} class="book-page" data-book-page>
            {book && <>
              <p class="book-category"><LocalizedText text={bookDetails[index]!.category} /></p>
              <h3><LocalizedText text={bookDetails[index]!.title} /></h3>
              <p class="book-authors"><LocalizedText text={bookDetails[index]!.authors} /></p>
              <p class="book-description"><LocalizedText text={bookDetails[index]!.description} /></p>
            </>}
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .book-shelf { --spine-width: clamp(38px, 4vw, 56px); }
  .book-shelf-scroll { container-type: inline-size; overflow-x: auto; overscroll-behavior-inline: contain; padding: 8px 4px 24px; scrollbar-width: thin; scrollbar-color: #cbd5e1 transparent; }
  .book-track { display: flex; gap: 10px; height: 460px; perspective: 1400px; }
  .book {
    position: relative;
    flex: 1 1 0;
    min-width: 26px;
    overflow: hidden;
    border-radius: 5px 9px 9px 5px;
    background: var(--book-surface);
    box-shadow: 0 12px 18px -16px rgb(15 23 42 / 50%);
    transform-style: preserve-3d;
    transform-origin: center;
  }
  .book:has(.book-select:checked) { flex-grow: var(--book-expanded-grow); }
  .book-placeholder { background: #000; }
  .book-placeholder:has(.book-select:checked) { background: #000; }
  .book:has(.book-select:focus-visible) { outline: 2px solid var(--accent-ink); outline-offset: 3px; }
  .book-spine {
    position: absolute;
    inset: 0 auto 0 0;
    display: flex;
    align-items: center;
    width: 100%;
    padding: 40px 0 28px;
    border-radius: inherit;
    color: #fff;
    background: #2346b4;
    box-shadow: inset 4px 0 5px rgb(255 255 255 / 10%), inset -4px 0 6px rgb(0 0 0 / 18%);
    flex-direction: column;
    cursor: pointer;
    user-select: none;
    z-index: 1;
  }
  .book:has(.book-select:checked) .book-spine { width: var(--spine-width); border-radius: 5px 0 0 5px; }
  .book-placeholder .book-spine { width: 100%; background: #000; box-shadow: none; }
  .book-placeholder:has(.book-select:checked) .book-spine { width: 100%; border-radius: inherit; }
  .book-spine-title { writing-mode: vertical-rl; font-family: "Songti SC", "SimSun", serif; font-size: 25px; font-weight: 600; letter-spacing: 0.26em; }
  .book-spine-author { margin-top: auto; writing-mode: vertical-rl; font-size: 11px; letter-spacing: 0.12em; color: rgb(255 255 255 / 76%); }
  /* 共用窄幅排版，封面的图形与文字位置由各书籍素材和变体控制。 */
  .book-spine-illustrated {
    padding: 132px 0 20px;
    background-color: #5879a6;
    background-size: 100% 100%;
    background-repeat: no-repeat;
    color: var(--book-spine-ink, #fff);
    box-shadow: inset 3px 0 5px rgb(255 255 255 / 8%), inset -3px 0 6px rgb(21 43 76 / 24%);
  }
  .book-spine-english { position: absolute; top: 108px; left: 6px; right: 6px; color: var(--book-spine-muted, #e7e9d2); font-family: Georgia, serif; font-size: 6px; line-height: 1.1; text-align: center; }
  .book-spine-illustrated .book-spine-title { font-weight: 400; letter-spacing: 0.18em; text-shadow: 0 1px 1px rgb(26 48 81 / 22%); }
  .book-spine-illustrated .book-spine-author { margin-top: 22px; font-size: 9px; color: var(--book-spine-muted, #f0f0df); }
  .book-spine-publisher { display: grid; gap: 2px; margin-top: auto; color: #f0f0df; font-family: "Songti SC", "SimSun", serif; font-size: 7px; line-height: 1.3; letter-spacing: 0.08em; text-align: center; }
  /* 按用户提供的四张封面保留各自的留白、标题位置和字形。 */
  .book-spine-subtitle { position: absolute; bottom: 64px; writing-mode: vertical-rl; font-size: 8px; letter-spacing: 0.12em; line-height: 1.4; }
  .book-spine-naval { padding-top: 92px; }
  .book-spine-naval .book-spine-english { top: 22px; color: #30343b; font-family: Arial, sans-serif; font-weight: 700; }
  .book-spine-naval .book-spine-title { font-weight: 600; text-shadow: 0 1px 0 rgb(255 255 255 / 80%); }
  .book-spine-naval .book-spine-subtitle { color: #41434a; }
  .book-spine-history { padding-top: 78px; }
  .book-spine-history .book-spine-english { top: 24px; font-size: 7px; }
  .book-spine-history .book-spine-author { margin-top: 16px; }
  .book-spine-history .book-spine-subtitle { bottom: 20px; color: #2d2b28; }
  .book-spine-thinking .book-spine-english { top: auto; bottom: 24px; }
  .book-spine-thinking .book-spine-title { font-weight: 600; text-shadow: none; }
  .book-spine-mao { padding-top: 68px; }
  .book-spine-mao .book-spine-title { font-family: "STXingkai", "华文行楷", "KaiTi", "STKaiti", serif; font-size: 32px; letter-spacing: 0.3em; text-shadow: none; }
  .book-spine-mao .book-spine-author { margin-top: 28px; }
  .book-page { position: absolute; inset: 0 0 0 var(--spine-width); padding: 32px; overflow-y: auto; border-radius: 0 9px 9px 0; opacity: 0; visibility: hidden; pointer-events: none; }
  .book:has(.book-select:checked) .book-page { opacity: 1; visibility: visible; pointer-events: auto; }
  /* 正文保持展开后的排版宽度，切换时只渐隐和平移，避免逐帧重新换行。 */
  .book-shelf[data-enhanced="true"] .book-page { right: auto; width: calc(var(--book-expanded-width) - var(--spine-width)); visibility: visible; }
  .book-category { color: var(--accent-ink); font-size: 11px; line-height: 1.5; letter-spacing: 0.12em; }
  .book-page h3 { margin-top: 20px; color: var(--page-ink); font-family: "Songti SC", "SimSun", serif; font-size: 34px; font-weight: 600; line-height: 1.2; }
  .book-authors { margin-top: 14px; color: var(--muted-ink); font-size: 12px; line-height: 1.8; }
  .book-description { margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border-color); color: var(--body-copy); font-size: 15px; line-height: 1.9; }
  .book-hint { margin-top: 4px; color: #6b7280; font-size: 12px; line-height: 1.8; }
  .book-hint-touch { display: none; }
  /* 桌面书籍均分整排，倾斜投影的临时溢出不应生成滚动条或改变外层高度。 */
  @media (min-width: 1024px) {
    .book-shelf-scroll { overflow-x: clip; overflow-y: visible; }
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .book-page { padding: 24px; }
    .book-page h3 { font-size: 28px; }
    .book-description { font-size: 14px; }
  }
  @media (max-width: 1023px) {
    .book-shelf { --spine-width: 38px; }
    .book-track { width: max-content; min-width: 100%; height: 480px; gap: 6px; }
    .book { flex: 0 0 auto; width: 38px; }
    /* 按书架自身宽度展开，避免系统滚动条或页面边距裁掉正文。 */
    .book:has(.book-select:checked) { flex-grow: 0; width: min(360px, 100cqw); }
    .book-spine { padding-top: 36px; }
    .book-spine-illustrated { padding-top: 142px; }
    .book-spine-english { top: 116px; font-size: 5.5px; }
    .book-spine-title { font-size: 22px; }
    .book-spine-naval { padding-top: 96px; }
    .book-spine-naval .book-spine-english { top: 22px; }
    .book-spine-history { padding-top: 82px; }
    .book-spine-history .book-spine-english { top: 24px; font-size: 6px; }
    .book-spine-thinking .book-spine-english { top: auto; }
    .book-spine-mao { padding-top: 72px; }
    .book-spine-mao .book-spine-title { font-size: 28px; }
    .book-page { padding: 24px 18px; }
    .book-page h3 { font-size: 28px; }
    .book-description { margin-top: 20px; padding-top: 16px; font-size: 14px; line-height: 1.85; }
    .book-hint-desktop { display: none; }
    .book-hint-touch { display: inline; }
  }
  @media (hover: none) {
    .book-hint-desktop { display: none; }
    .book-hint-touch { display: inline; }
  }
</style>

<script>
  import { initBookShelf } from "../scripts/bookShelf";

  // 热更新时只清理书架自己的动画和监听。
  const disposeBookShelf = initBookShelf();
  if (import.meta.hot) import.meta.hot.dispose(disposeBookShelf);
</script>

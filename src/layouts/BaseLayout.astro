---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  homePath?: string;
}

const {
  title = `${siteConfig.name} - 个人简介`,
  description = siteConfig.description,
  canonicalPath = "/",
  homePath = "",
} = Astro.props;
const canonical = new URL(canonicalPath, "https://ybh-ybh.github.io").toString();
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: siteConfig.name,
  url: "https://ybh-ybh.github.io/",
  jobTitle: siteConfig.title,
  alumniOf: { "@type": "CollegeOrUniversity", name: "武汉大学" },
  sameAs: [siteConfig.social.github, siteConfig.social.douyin],
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      // 在样式和正文绘制前恢复主题，避免深色刷新时先闪出白色。
      (() => {
        // 无手动选择时跟随系统，浏览器禁用存储也可正常显示。
        let savedTheme = null;
        try { savedTheme = localStorage.getItem("portfolio-theme"); } catch {}
        // 只接受本站支持的两个主题值。
        const theme = savedTheme === "light" || savedTheme === "dark"
          ? savedTheme : matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]').setAttribute("content", theme === "dark" ? "#0c1220" : "#ffffff");
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,400;1,500&display=swap"
      rel="stylesheet"
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <title>{title}</title>
  </head>
  <body>
    <Header homePath={homePath} />
    <main><slot /></main>
    <Footer />
  </body>
</html>
